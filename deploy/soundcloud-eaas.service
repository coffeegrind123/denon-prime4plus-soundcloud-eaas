[Unit]
Description=SoundCloud EaaS source for Engine OS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/data/prime4-app/soundcloud-eaas.env
ExecStart=/data/prime4-app/bin/soundcloud-eaas \
    --user ${SC_PROFILE} \
    --host-ip ${SC_EAAS_HOST_IP} \
    --cache /data/prime4-app/cache \
    --max-feed-items ${SC_MAX_FEED_ITEMS}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
